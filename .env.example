# CarePath AI Environment Configuration
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# AI Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT=30

# Server Configuration
PORT=8000

# CORS Configuration
# Comma-separated list of allowed origins for API access
# Production example: ALLOWED_ORIGINS=https://carepath-ai-rho.vercel.app
# Development example: ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
